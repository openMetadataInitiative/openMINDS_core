{
  "_extends": "digitalRepresentation.schema.tpl.json",
  "_type": "core:RasterImage",
  "required": [
    "dimension",
    "pixelSize"
  ],
  "properties": {
    "dimension": {
      "_instruction": "Enter the dimension of this image in pixels.",
      "items": {
        "type": "integer"
      },
      "maxItems": 2,
      "minItems": 2,
      "type": "array"
    },
    "pixelSize": {
      "_embeddedTypes": [
        "core:QuantitativeValue"
      ],
      "_instruction": "Enter the physical pixel size for this image (in x,y order).",
      "maxItems": 2,
      "minItems": 2,
      "type": "array"
    }
  }
}